{
  "name": "typo3-contributor",
  "displayName": "TYPO3 Contributor",
  "description": "Contribute to TYPO3 Core with an AI agent under human supervision: setup checks, QA, pre-push gate and read-only Gerrit/Forge tooling.",
  "version": "0.5.0",
  "author": {
    "name": "Olivier Dobberkau",
    "url": "https://github.com/dkd-dobberkau"
  },
  "homepage": "https://github.com/dkd-dobberkau/typo3-contributor-skill",
  "repository": "https://github.com/dkd-dobberkau/typo3-contributor-skill",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "typo3",
    "gerrit",
    "contribution",
    "code-review"
  ],
  "userConfig": {
    "container_runtime": {
      "type": "string",
      "title": "Container runtime",
      "description": "Runtime for Build/Scripts/runTests.sh (-b).",
      "options": [
        "docker",
        "podman"
      ],
      "required": false,
      "default": "docker"
    },
    "core_dir": {
      "type": "directory",
      "title": "TYPO3 Core checkout",
      "description": "Path of your typo3/typo3 checkout. Unset means ~/work/TYPO3-Contribute.",
      "required": false
    }
  }
}
